# ==============================================================================
# Fictional AI Character - Instagram Browser Agent Environment Configuration
# ==============================================================================

# LLM Provider Configuration
LLM_PROVIDER=groq
LLM_MODEL=openai/gpt-oss-120b
LLM_FALLBACK_MODEL=gemini-3.6-flash
GROQ_API_KEY=your_groq_api_key_here
OPENROUTER_API_KEY=your_openrouter_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# Persistence & Storage
DATABASE_PATH=data/agent.db

# Browser Automation & Profile
BROWSER_PROFILE_PATH=data/browser_profile
BROWSER_HEADLESS=false
BROWSER_VIEWPORT_WIDTH=1280
BROWSER_VIEWPORT_HEIGHT=800

# Instagram Targeting (Optional: Set specific handle/thread to monitor)
TARGET_THREAD_ID=
TARGET_USERNAME=
MONITOR_ALL_INBOX=false

# Automation Polling & Rate Limits
INBOX_POLL_INTERVAL_SECONDS=5
MAX_REPLIES_PER_HOUR=30
MIN_REPLY_DELAY_SECONDS=3.0
MAX_REPLY_DELAY_SECONDS=7.0

# Logging & Observability
LOG_LEVEL=INFO
LOG_FORMAT=console
LOG_SANITIZE_MESSAGES=false
LOG_FILE_PATH=logs/agent.jsonl

# RAG & Embedding
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
RAG_SIMILARITY_THRESHOLD=0.65
RAG_TOP_K=3
